<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="task11_car">

<material name="blue">
    <color rgba="0.0 0.3 1.0 1.0"/>
</material>

<material name="red">
    <color rgba="1.0 0.0 0.0 1.0"/>
</material>


<link name = "base_link">
   <visual>
       <origin xyz="0 0 0.5" rpy="0 0 0"/>
       <geometry>
           <box size = "2.0 1.2 0.4"/>
       </geometry>
       <material name="blue"/>

   </visual>

   <collision>
       <geometry>
           <box size = "2.0 1.2 0.4"/>
       </geometry>
   </collision>

   <inertial>
      <mass value = "10.0"/>

      <inertia
          ixx="1.267"
          ixy="0"
          ixz="0"
          iyy="3.467"
          iyz="0"
          izz="4.267"/>
      </inertial>

</link>

<xacro:macro name="wheel" params="wheel_name joint_name x y ">
   <link name = "${wheel_name}">
       <visual>
           <origin xyz="0 0 0" rpy="1.5708 0 0"/>

           <geometry>
              <cylinder radius="0.3" length="0.2"/>
           </geometry>
           <material name="red"/>
       </visual>

       <collision>
           <origin xyz="0 0 0" rpy="1.5708 0 0"/>
           <geometry>
              <cylinder radius="0.3" length="0.2"/>
           </geometry>
       </collision>

       <inertial>
           <mass value = "2.0"/>

           <inertia
              ixx="0.0567"
              ixy="0"
              ixz="0"
              iyy="0.0900"
              iyz="0"
              izz="0.0567"/>
      </inertial>
  
   </link>

   <joint name = "${joint_name}" type = "continuous" >
       <parent link = "base_link"/>
       <child link = "${wheel_name}"/>

       <axis xyz  = "0 1 0"/>
       <origin xyz="${x} ${y} 0.289" rpy="0 0 0"/>

   </joint>

</xacro:macro>
<xacro:wheel
    wheel_name="front_left_wheel"
    joint_name="front_left_joint"
    x="0.7"
    y="0.7"
/>

<xacro:wheel
    wheel_name="front_right_wheel"
    joint_name="front_right_joint"
    x="0.7"
    y="-0.7"
/>

<xacro:wheel
    wheel_name="rear_left_wheel"
    joint_name="rear_left_joint"
    x="-0.7"
    y="0.7"
/>

<xacro:wheel
    wheel_name="rear_right_wheel"
    joint_name="rear_right_joint"
    x="-0.7"
    y="-0.7"
/>

<link name = "camera_link">
   <visual>
       <origin xyz="0 0 0.5" rpy="0 0 0"/>
       <geometry>
           <box size="0.3 0.2 0.2"/>
       </geometry>
   </visual>

   <collision>
       <geometry>
           <box size="0.3 0.2 0.2"/>
       </geometry>
   </collision>

   <inertial>
      <mass value = "0.5"/>

      <inertia
          ixx="0.00333"
          ixy="0"
          ixz="0"
          iyy="0.00541"
          iyz="0"
          izz="0.00541"/>
      </inertial>

</link>

   <joint name = "camera_joint" type = "fixed" >
       <parent link = "base_link"/>
       <child link = "camera_link"/>

       <origin xyz="0.8 0  0.3" rpy="0 0 0"/>

   </joint>

  <gazebo>
    
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <left_joint>front_left_joint</left_joint>
      <left_joint>rear_left_joint</left_joint>
      <right_joint>front_right_joint</right_joint>
      <right_joint>rear_right_joint</right_joint>

      <wheel_separation>1.4</wheel_separation>
      <wheel_radius>0.3</wheel_radius>

      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>

    </plugin>

  </gazebo>

</robot>

